FROM node:20-alpine

WORKDIR /app

# Install Angular CLI globally
RUN npm install -g @angular/cli@19

# Install OpenSSL for certificate generation
RUN apk add --no-cache openssl curl

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --silent

# Copy source code
COPY . .

# Create SSL directory
RUN mkdir -p /app/ssl

# Expose ports for Angular dev server (HTTPS) and live reload
EXPOSE 4200 49153

# Health check for HTTPS
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -k -f https://localhost:4200 || exit 1

# Start development server with HTTPS
CMD ["ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--ssl", "--ssl-key", "/app/ssl/localhost-key.pem", "--ssl-cert", "/app/ssl/localhost.pem", "--poll", "2000"]